#!/usr/bin/env bash
# Refuse to commit/merge fork-only paths (listed in fork/fork-only-paths on devel) anywhere but on the fork branches:
# devel, stable and release-* carry the fork; main mirrors upstream and contribution branches start from it (fork/RELEASING.md).
# Installed as .git/hooks/pre-commit and .git/hooks/pre-merge-commit by `make init`.
branch=$(git branch --show-current)
case "$branch" in
  ""|devel|stable|release-*) exit 0 ;;
esac
list=$(git show devel:fork/fork-only-paths 2>/dev/null) || exit 0
bad=0
while IFS= read -r file; do
  while IFS= read -r p; do
    [ -z "$p" ] && continue
    p=${p%/}
    if [ "$file" = "$p" ] || [[ "$file" == "$p"/* ]]; then
      echo "fork-only path '$file' must not be versioned on '$branch' (only on devel, stable and release-*)" >&2
      bad=1
    fi
  done <<< "$list"
done < <(git diff --cached --name-only)
exit $bad
